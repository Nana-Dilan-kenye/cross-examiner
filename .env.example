# Meterless Runtime (OpenAI-compatible endpoint) configuration.
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Never commit the runtime token.
#
# The variable names follow the official runtime contract:
#   METERLESS_BASE_URL        the Runtime's OpenAI-compatible base URL
#   METERLESS_RUNTIME_TOKEN   the Runtime token from the Nightshift Console
#   METERLESS_MODEL           a model id the Runtime advertises
#
# METERLESS_API_KEY is still accepted as an alias for
# METERLESS_RUNTIME_TOKEN, but the documented name is the one above.

# Base URL of the OpenAI-compatible endpoint.
#   Windows loopback only (the runtime's default public_listen)  -> http://127.0.0.1:8088/v1
#   From WSL, reach the Windows host by its LAN/hotspot address  -> http://<windows-ip>:8088/v1
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# Base URL used by the Windows transport (the Windows curl.exe runs on the
# Windows side, where the loopback address works). Defaults to the value
# above. WSL and the Windows host do not share a loopback, so from WSL this
# is the address that actually works.
METERLESS_BASE_URL_WINDOWS=http://127.0.0.1:8088/v1

# Transport: auto | http | windows-curl
#   auto         prefer the Windows curl.exe when it exists, then direct HTTP
#   http         direct HTTP only
#   windows-curl only the Windows curl.exe
METERLESS_TRANSPORT=auto

# Bearer token for the runtime proxy.
# On Windows this is the content of
#   %LOCALAPPDATA%\ai.meterless.runtime\proxy-token
# METERLESS_RUNTIME_TOKEN=replace-me

# Model id to request.
# meterless/auto is the documented default, but it resolves to the runtime's active lane model,
# which may be unavailable for the configured provider account. Always verify the model id you
# set actually answers /v1/chat/completions before relying on it.
# The project pins a Nemotron-backed lane so the NVIDIA contribution is unambiguous:
#   METERLESS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_MODEL=meterless/auto

# Per-request timeout in seconds. Keep this larger than METERLESS_TTFB_MS.
METERLESS_TIMEOUT=180

# Optional: how long the runtime may wait for the model's first token
# (sent as the meterless-ttfb-ms header, max 300000). Raise this for slow
# cloud models, otherwise the runtime stops the lane with HTTP 504.
METERLESS_TTFB_MS=120000

# How many times a transient failure (connection error, 502/503/504) is retried.
METERLESS_MAX_RETRIES=1

# The application identifies itself to the runtime with the meterless-app
# header, and scopes a chat request with meterless-scope: user. Both are
# part of the runtime contract and are set by the client, not here.
